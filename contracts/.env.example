# Deployer key (needs a little BOT / tBOT for gas). Never commit the real .env
PRIVATE_KEY=0xyour_private_key_here
BOTCHAIN_RPC=https://rpc.bohr.life
BOTCHAIN_MAINNET_RPC=https://rpc.botchain.ai

# Your own wallet: owns the contract settings
OWNER=
# Receives the protocol fee (defaults to OWNER)
TREASURY=
# Settles disputes. Use a separate wallet: the arbiter can't buy or sell through the escrow
ARBITER=
# Protocol fee in basis points (50 = 0.5%, max 100). Each deal pays at most 5 USDT
FEE_BPS=50

# Testnet only (mainnet always uses the official USDT)
USDT_ADDRESS=0x75edC9335175Fc0552D51D48439F229c10420fe3
